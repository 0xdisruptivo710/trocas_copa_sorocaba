NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AbacatePay — gateway de pagamento (PIX)
# Pegue a key no dashboard (https://abacatepay.com → Integrar → API Keys).
# Use chave Dev Mode pra testes; chave Prod pra produção. Mesma URL base.
ABACATEPAY_API_KEY=

# Segredo do webhook: gere algo aleatório e configure no dashboard como
# https://<seu-app>/api/abacatepay?webhookSecret=<este_valor>
TROCAS_WEBHOOK_SECRET=
